// K-Scope M0 — jit.gl.pix gen codebox (paste into a gen editor inside jit.gl.pix).
// in1 = magnitude texture (1 x Nbins, float32, linear POWER), written by jit.poke~.
// Maps a log-frequency vertical axis -> magnitude -> dB -> inferno-ish colormap.
// Float32 sampling correctness through this shader is GATE D (no 8-bit banding).

Param dbFloor(-100.);
Param dbCeil(0.);
Param flow(4.3219);    // log2(20)   — 20 Hz
Param fhigh(14.2877);  // log2(20000) — 20 kHz

// vertical axis = log frequency -> back to a 0..1 linear bin coordinate
ylog  = mix(flow, fhigh, norm.y);
fnorm = (pow(2., ylog) - 20.) / (20000. - 20.);

mag = sample(in1, vec(fnorm, 0.)).r;          // float32 magnitude (power)
db  = 10. * log10(max(mag, 1e-9));
v   = clamp((db - dbFloor) / (dbCeil - dbFloor), 0., 1.);

// compact inferno-ish colormap (no LUT texture needed for M0)
r = clamp(1.6 * v - 0.2, 0., 1.);
g = clamp(2.0 * v * v - 0.1, 0., 1.);
b = clamp(0.9 - 1.3 * abs(v - 0.35), 0., 1.) + 0.15 * v;

out1 = vec(r, g, b, 1.);
